# Copy to .env (never commit it). docker compose reads it automatically.
OWNER_PASSWORD=change-me
SESSION_SECRET=generate-with-openssl-rand-hex-32
POSTGRES_PASSWORD=monitor

# Local plain-HTTP runs need this off; keep it true behind HTTPS.
SECURE_COOKIES=false

# Deploy: pull the CI-built image instead of building, and choose the bind address.
# APP_IMAGE=docker.io/<dockerhub-user>/claude-usage-monitor:latest
# APP_BIND=127.0.0.1

# Optional: count every commit in your GitLab group (not just Claude's). Token needs read_api only.
# GITLAB_TOKEN=glpat-...
# GITLAB_GROUP=your-group
# GITLAB_URL=https://gitlab.com

# Optional: count every commit in a GitHub organization (default branch of each repo). Fine-grained token,
# resource owner = the org, all repositories, read-only Contents (Metadata comes with it).
# GITHUB_TOKEN=
# GITHUB_ORG=Tulip-Tech
