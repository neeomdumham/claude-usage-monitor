{
  "name": "claude-usage-monitor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev:server": "pnpm --filter @usage-monitor/server dev",
    "dev:dashboard": "pnpm --filter @usage-monitor/dashboard dev",
    "build": "pnpm --filter @usage-monitor/dashboard build",
    "test": "node --test \"apps/server/src/**/*.test.ts\"",
    "typecheck": "tsc -p packages/contracts && tsc -p apps/server && tsc -p apps/dashboard",
    "changelog:draft": "node scripts/changelog-draft.mjs",
    "changelog:section": "node scripts/changelog-section.mjs",
    "release:cut": "node scripts/cut-release.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
