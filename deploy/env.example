# On the server: cd /opt/monitor && cp env.example .env && chmod 600 .env, then fill in. Never commit the real file.
# APP_IMAGE is written by box.sh at each deploy.
DOMAIN=claude-monitor.moeenmahmud.com
OWNER_PASSWORD=
# openssl rand -hex 32 (each)
SESSION_SECRET=
POSTGRES_PASSWORD=

# Optional: count every commit in your GitLab group. Token needs read_api only.
# GITLAB_TOKEN=
# GITLAB_GROUP=

# Optional: count every commit in a GitHub organization (default branch of each repo). Fine-grained token,
# resource owner = the org, all repositories, read-only Contents (Metadata comes with it).
# GITHUB_TOKEN=
# GITHUB_ORG=Tulip-Tech
